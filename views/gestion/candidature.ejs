<%- include('../partials/header') %>
<p class="crumb"><a href="/gestion/candidatures">← Toutes les candidatures</a></p>
<div class="two">
  <section class="panel">
    <div class="headrow"><h1><%= d.prenom %> <%= d.nom %></h1><%- badge(d.statut) %></div>
    <p class="sub">Candidature à « <%= d.titre %> » · <%= d.departement %> · reçue le <%= date(d.date_soumission) %></p>
    <dl class="info">
      <dt>E-mail</dt><dd><%= d.email %></dd>
      <dt>Téléphone</dt><dd><%= d.telephone || '—' %></dd>
      <dt>Date de naissance</dt><dd><%= date(d.date_naissance) || '—' %></dd>
      <dt>Adresse</dt><dd><%= d.adresse || '—' %></dd>
    </dl>
    <% if (d.message) { %><h3>Message du candidat</h3><p class="msgcand"><%= d.message %></p><% } %>
    <h3>Pièces jointes</h3>
    <ul class="pj">
      <li><a href="/candidatures/<%= d.id %>/fichier/cv">📄 CV</a></li>
      <li><a href="/candidatures/<%= d.id %>/fichier/lettre_motivation">📄 Lettre de motivation</a></li>
      <li><% if (d.convention) { %><a href="/candidatures/<%= d.id %>/fichier/convention">📄 Convention de stage</a><% } else { %><span class="muted">Convention de stage : non fournie</span><% } %></li>
    </ul>
  </section>
  <aside class="panel">
    <h3>Décision</h3>
    <p class="small">Places restantes sur l'offre : <b><%= d.places_disponibles %></b></p>
    <form method="post" action="/gestion/candidatures/<%= d.id %>/statut" class="form">
      <% STATUTS.forEach(s => { %>
        <label class="radio"><input type="radio" name="statut" value="<%= s %>" <%= d.statut === s ? 'checked' : '' %>> <%= s.charAt(0).toUpperCase() + s.slice(1) %></label>
      <% }) %>
      <button class="btn full" type="submit">Enregistrer la décision</button>
      <p class="small">Le candidat est prévenu automatiquement (notification et e-mail).</p>
    </form>
    <a class="btn ghost full" href="/messages/<%= d.id_utilisateur %>">✉️ Écrire au candidat</a>
  </aside>
</div>
<%- include('../partials/footer') %>
