<%- include('partials/header') %>
<section class="panel narrow wide">
  <h1>Mon profil</h1>
  <p class="sub"><%= u.email %> · <span class="role"><%= u.role %></span></p>
  <% if (ok) { %><p class="alert ok"><%= ok %></p><% } %>
  <% if (erreur) { %><p class="alert err"><%= erreur %></p><% } %>
  <form method="post" action="/profil" class="form">
    <div class="grid">
      <label>Nom *<input name="nom" value="<%= u.nom %>" required></label>
      <label>Prénom *<input name="prenom" value="<%= u.prenom %>" required></label>
      <label>Téléphone<input name="telephone" value="<%= u.telephone || '' %>"></label>
      <label>Date de naissance<input type="date" name="date_naissance" value="<%= u.date_naissance || '' %>"></label>
      <label class="full">Adresse<input name="adresse" value="<%= u.adresse || '' %>"></label>
    </div>
    <button class="btn" type="submit">Enregistrer</button>
  </form>
</section>
<%- include('partials/footer') %>
