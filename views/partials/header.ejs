<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= titre %> — Plateforme d'offres de stages</title>
<link rel="stylesheet" href="/css/style.css">
</head><body>
<%
  const lien = (href, ico, texte, actif, extra) => `<a href="${href}" class="${actif ? 'on' : ''}">${icone(ico)}<span>${texte}</span>${extra || ''}</a>`;
  const pill = (n) => n ? ` <span class="pill">${n}</span>` : '';
  const staff = user && user.role !== 'stagiaire';
%>
<header class="top"><nav class="menu" aria-label="Menu principal">
  <%- lien('/', 'accueil', 'Accueil', chemin === '/') %>
  <%- lien('/offres', 'offres', 'Offres', chemin.startsWith('/offres') || chemin.startsWith('/gestion/offres')) %>
  <% if (staff) { %>
    <%- lien('/candidats', 'candidats', 'Candidats', chemin === '/candidats') %>
    <%- lien('/gestion/candidatures', 'candidatures', 'Candidatures', chemin.startsWith('/gestion')  && !chemin.startsWith('/gestion/offres')) %>
    <%- lien('/agents', 'agents', 'Agents', chemin === '/agents' || chemin.startsWith('/admin')) %>
  <% } else if (user) { %>
    <%- lien('/mes-candidatures', 'candidatures', 'Candidatures', chemin === '/mes-candidatures') %>
  <% } %>
  <% if (user) { %>
    <%- lien('/documents', 'documents', 'Documents', chemin === '/documents') %>
    <%- lien('/messages', 'messages', 'Messages', chemin.startsWith('/messages'), pill(nbMessages)) %>
    <% if (!staff) { %><%- lien('/notifications', 'notifications', 'Notifications', chemin === '/notifications', pill(nbNotifs)) %><% } %>
    <%- lien('/profil', 'profil', user.prenom, chemin === '/profil') %>
    <form method="post" action="/deconnexion" class="inline"><button class="linkbtn"><%- icone('deconnexion') %><span>Déconnexion</span></button></form>
  <% } else { %>
    <%- lien('/connexion', 'connexion', 'Connexion', chemin === '/connexion') %>
    <%- lien('/inscription', 'inscription', 'Inscription', chemin === '/inscription') %>
  <% } %>
</nav></header>
<main class="wrap">
<% if (flash) { %><p class="alert ok"><%= flash %></p><% } %>
