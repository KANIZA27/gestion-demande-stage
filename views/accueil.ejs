<%- include('partials/header') %>
<h1 class="centre">Bienvenue sur notre plateforme d'offres des stages</h1>
<section class="bloc">
  <h2>À propos de notre plateforme</h2>
  <p>Cette plateforme permet de consulter les offres de stage du Conseil Départemental de Mayotte, de postuler en ligne avec son CV, sa lettre de motivation et sa convention de stage, puis de suivre l'état de sa demande. Elle s'adresse principalement aux étudiants et aux jeunes diplômés.</p>
  <% if (!user) { %><p class="row"><a class="btn" href="/inscription">Créer mon compte</a> <a href="/connexion">J'ai déjà un compte</a></p><% } %>
</section>
<section class="bloc">
  <h2>Les offres à consulter</h2>
  <% if (!offres.length) { %><p class="empty">Aucune offre pour le moment.</p><% } %>
  <div class="offres">
    <% offres.forEach(o => { %><%- include('partials/offre-carte', { o }) %><% }) %>
  </div>
</section>
<%- include('partials/footer') %>
