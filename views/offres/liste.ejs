<%- include('../partials/header') %>
<div class="headrow">
  <div><h1 class="ptitle">Les offres de stage</h1><p class="sub">Les stages proposés par les services du Département.</p></div>
  <div class="row" style="margin:0">
    <form method="get" action="/offres" class="filter">
      <label class="sr" for="service">Service</label>
      <select id="service" name="service" onchange="this.form.submit()">
        <option value="">Tous les services</option>
        <% services.forEach(s => { %><option <%= s === service ? 'selected' : '' %>><%= s %></option><% }) %>
      </select>
    </form>
    <% if (user && user.role !== 'stagiaire') { %><a class="btn sm" href="/gestion/offres">Gérer les offres</a><% } %>
  </div>
</div>
<% if (!offres.length) { %><p class="empty">Aucune offre pour le moment.</p><% } %>
<div class="offres">
  <% offres.forEach(o => { %><%- include('../partials/offre-carte', { o }) %><% }) %>
</div>
<%- include('../partials/footer') %>
