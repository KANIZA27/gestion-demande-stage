<%- include('../partials/header') %>
<p class="crumb"><a href="/gestion/offres">← Gérer les offres</a></p>
<section class="panel narrow wide">
  <h1><%= o.id ? "Modifier l'offre" : "Nouvelle offre de stage" %></h1>
  <% if (erreur) { %><p class="alert err"><%= erreur %></p><% } %>
  <form method="post" action="<%= o.id ? '/gestion/offres/' + o.id + '/modifier' : '/gestion/offres/nouvelle' %>" class="form">
    <label>Titre de l'offre *<input name="titre" value="<%= o.titre || '' %>" required></label>
    <div class="grid">
      <label>Service / département *<input name="departement" value="<%= o.departement || '' %>" list="services" required></label>
      <label>Places disponibles *<input type="number" min="0" name="places_disponibles" value="<%= o.places_disponibles ?? 1 %>" required></label>
      <label>Date de début<input type="date" name="date_debut" value="<%= o.date_debut || '' %>"></label>
      <label>Date de fin<input type="date" name="date_fin" value="<%= o.date_fin || '' %>"></label>
      <label>Date limite pour postuler<input type="date" name="date_limite" value="<%= o.date_limite || '' %>"></label>
    </div>
    <datalist id="services"><option>Direction du Numérique (DNSI)</option><option>Ressources Humaines</option><option>Communication</option><option>Action sociale</option></datalist>
    <label>Description<textarea name="description" rows="5"><%= o.description || '' %></textarea></label>
    <button class="btn" type="submit"><%= o.id ? 'Enregistrer les modifications' : "Publier l'offre" %></button>
  </form>
</section>
<%- include('../partials/footer') %>
